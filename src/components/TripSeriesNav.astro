---
import { url } from '../lib/paths';

interface NavLink {
  label: string;
  title: string;
  href: string;
}

interface Props {
  overviewHref?: string;
  overviewTitle?: string;
  prev?: NavLink;
  next?: NavLink;
}

const {
  overviewHref = '/blog/paris-florence-sorrento-rome-2013/',
  overviewTitle = 'A September from Paris to Rome (full trip overview & map)',
  prev,
  next,
} = Astro.props;
---

<nav class="trip-series-nav" aria-label="Trip series navigation">
  <p class="trip-series-kicker">
    Part of the 2013 trip series: <a href={url(overviewHref)}>{overviewTitle}</a>
  </p>
  <div class="trip-series-links">
    {
      prev ? (
        <a class="trip-series-card" href={url(prev.href)}>
          <span class="trip-series-dir">&larr; {prev.label}</span>
          <strong>{prev.title}</strong>
        </a>
      ) : (
        <div />
      )
    }
    {
      next ? (
        <a class="trip-series-card trip-series-next" href={url(next.href)}>
          <span class="trip-series-dir">{next.label} &rarr;</span>
          <strong>{next.title}</strong>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</nav>
