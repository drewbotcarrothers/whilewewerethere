---
/** Decorative homepage illustration. Not a photograph and not a record of a specific trip. */
---

<div class="hero-frame">
  <svg viewBox="0 0 640 720" role="img" aria-label="Illustrated lookout with pines, a path, and a small Toronto skyline.">
    <title>Illustrated lookout</title>
    <defs>
      <linearGradient id="sky" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="#f7e7c0" />
        <stop offset="45%" stop-color="#d5ebf3" />
        <stop offset="100%" stop-color="#b7d7e4" />
      </linearGradient>
    </defs>
    <rect width="640" height="720" fill="url(#sky)" />
    <circle cx="500" cy="132" r="54" fill="#f2c14e" />
    <circle cx="500" cy="132" r="78" fill="#f2c14e" opacity="0.25" />
    <path d="M0 470 C120 430 180 500 280 470 C390 436 430 390 520 430 C580 456 610 470 640 450 L640 720 L0 720 Z" fill="#7ea38d" />
    <path d="M0 540 C90 500 160 580 270 550 C390 516 450 500 640 560 L640 720 L0 720 Z" fill="#1b4332" />
    <path d="M250 720 C270 560 300 520 318 470 C336 520 366 600 390 720 Z" fill="#143528" />
    <rect x="308" y="430" width="14" height="70" rx="3" fill="#10281e" />
    <ellipse cx="315" cy="455" rx="22" ry="10" fill="#10281e" />
    <rect x="312" y="400" width="6" height="36" fill="#10281e" />
    <path d="M70 720 L110 470 L150 720 Z" fill="#14382b" />
    <path d="M120 720 L168 430 L216 720 Z" fill="#0f241b" />
    <path d="M430 720 L470 500 L510 720 Z" fill="#14382b" />
    <path d="M480 720 L530 460 L580 720 Z" fill="#0f241b" />
    <path d="M292 720 C300 640 318 600 318 560 C318 600 340 650 352 720" fill="none" stroke="#f4efe6" stroke-width="16" stroke-linecap="round" />
    <g fill="#fffaf3">
      <circle cx="196" cy="600" r="16" />
      <rect x="184" y="616" width="24" height="46" rx="10" />
      <circle cx="236" cy="608" r="15" />
      <rect x="225" y="622" width="22" height="40" rx="10" />
      <circle cx="268" cy="626" r="11" />
      <rect x="259" y="636" width="18" height="30" rx="8" />
      <circle cx="300" cy="628" r="11" />
      <rect x="291" y="638" width="18" height="28" rx="8" />
      <circle cx="332" cy="612" r="14" />
      <rect x="321" y="626" width="22" height="38" rx="10" />
    </g>
    <g>
      <rect x="404" y="150" width="150" height="118" rx="12" fill="#fffaf3" transform="rotate(6 404 150)" />
      <path d="M430 190 C470 170 520 210 560 186" fill="none" stroke="#c4654a" stroke-width="4" stroke-dasharray="7 7" transform="rotate(6 404 150)" />
      <circle cx="448" cy="214" r="6" fill="#1b4332" transform="rotate(6 404 150)" />
      <circle cx="548" cy="206" r="6" fill="#a34532" transform="rotate(6 404 150)" />
    </g>
  </svg>
</div>
