---
import { site } from '../data/site';
---

{
  site.affiliatesEnabled && (
    <aside class="affiliate-disclosure" role="note">
      <p>
        <strong>Affiliate disclosure.</strong> If this story includes affiliate links, we may earn a commission
        when you use them. You do not pay more because of that. A commission does not decide what we recommend.
        We write about what we actually used. If a trip was sponsored, the story says so on its own.
      </p>
    </aside>
  )
}
