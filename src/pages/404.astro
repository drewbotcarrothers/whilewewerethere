---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { url } from '../lib/paths';

const description = 'That page is not on the While We Were There site.';
---

<Base title="Page not found" description={description} noindex={true}>
  <div class="container lost">
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <circle cx="60" cy="60" r="52" fill="none" stroke="#1b4332" stroke-width="4" />
      <circle cx="60" cy="60" r="6" fill="#1b4332" />
      <path d="M60 60 L60 22" stroke="#a56b22" stroke-width="4" stroke-linecap="round" />
      <path d="M60 60 L86 74" stroke="#c4654a" stroke-width="3" stroke-linecap="round" />
      <text x="60" y="18" text-anchor="middle" font-size="12" font-family="Georgia, serif" fill="#1c1915">N</text>
    </svg>
    <p class="eyebrow">404</p>
    <h1>This page is not on our map.</h1>
    <p class="lede">The link may be old, or the story may not be published yet. The journal itself is still here.</p>
    <div class="button-row">
      <a class="btn" href={url('/')}>Back home</a>
      <a class="btn btn-secondary" href={url('/blog/')}>Read the stories</a>
      <a class="btn btn-secondary" href={site.youtube} rel="noopener noreferrer">YouTube</a>
    </div>
  </div>
</Base>
