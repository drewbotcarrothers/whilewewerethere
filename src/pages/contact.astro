---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { url } from '../lib/paths';

const description = 'Send a message to Andrew and Michelle at While We Were There.';
---

<Base title="Contact" description={description}>
  <div class="container post-hero-width-photos contact-grid">
    <header class="page-hero">
      <p class="eyebrow">Say hello</p>
      <h1>Contact</h1>
      <p class="lede">
        Questions, a place we should try, or a note about working together — send us a message and we will write back.
      </p>
      <p>
        For a brand partnership, you can also start from <a href={url('/work-with-us/')}>Work with us</a>.
      </p>
    </header>

    <p class="banner banner-ok" id="contact-sent" hidden role="status">
      Thank you. Your message is on its way, and we will get back to you.
    </p>
    <p class="banner" id="contact-error" hidden role="alert">
      Sorry, we could not send that. Please try again, or email <a href={`mailto:${site.email}`}>{site.email}</a> directly.
    </p>

    <form id="contact-form" action="/contact.php" method="post">
      <label class="hp" aria-hidden="true">
        Website
        <input name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>
      <label>
        Name
        <input name="name" type="text" autocomplete="name" maxlength="200" required />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" maxlength="200" required />
      </label>
      <label>
        <span>Subject <span class="optional">(optional)</span></span>
        <input name="subject" type="text" maxlength="200" />
      </label>
      <label>
        Message
        <textarea name="message" required maxlength="8000"></textarea>
      </label>
      <button class="btn" type="submit">Send message</button>
      <p class="fine">We read messages at {site.email} and reply from that address. We do not publish what you send us.</p>
    </form>
  </div>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const status = params.get('status');
  const sent = document.getElementById('contact-sent');
  const error = document.getElementById('contact-error');
  if (status === 'sent' && sent) sent.hidden = false;
  if (status && status !== 'sent' && error) error.hidden = false;
</script>
